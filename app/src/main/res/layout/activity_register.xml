<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white"
    tools:context=".ui.activity.RegisterActivity">


    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/regBack"
        android:layout_gravity="end|top"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:tint="@color/white"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Back"
        android:src="@drawable/baseline_arrow_back_24" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="20dp"> <!-- Added marginBottom to create a gap -->

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logo1"
            android:contentDescription="Gym Logo"/>

    </LinearLayout>

    <!-- Username Field -->
    <EditText
        android:id="@+id/editRegisterUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Full Name"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:padding="10dp"
        android:textColor="#333"
        android:textColorHint="#999"/>

    <!-- Email Address Field -->
    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:minHeight="48dp"
        android:padding="10dp"
        android:textColor="#333"
        android:textColorHint="#999"/>

    <!-- Address Field -->
    <EditText
        android:id="@+id/editAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Address"
        android:inputType="text"
        android:minHeight="48dp"
        android:padding="10dp"
        android:textColor="#333"
        android:textColorHint="#999"/>

    <!-- Password Field -->
    <EditText
        android:id="@+id/editPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:padding="10dp"
        android:textColor="#333"
        android:textColorHint="#999"/>

    <!-- Confirm Password Field -->
    <EditText
        android:id="@+id/editConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Confirm Password"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:padding="10dp"
        android:textColor="#333"
        android:textColorHint="#999"/>

    <!-- Register Button -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Register"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/holo_red_dark"
        android:padding="10dp"
        android:layout_marginTop="16dp"/>

    <!-- Already Have an Account Text -->
    <TextView
        android:id="@+id/textViewAlreadyAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hello Hi, Bye Bye!"
        android:textAlignment="center"
        android:textColor="@android:color/holo_red_light"
        android:padding="10dp"
        android:layout_marginTop="20sp"/>




</LinearLayout>
